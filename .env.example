# Copy to .env and fill in. Never commit .env.

# Long random tokens, different from each other. Generate each with: openssl rand -hex 32
# The Claude token goes in the claude.ai custom connector as a request header.
HUB_CLAUDE_TOKEN=
# The Pepper token stays on your server and is only accepted on the private listener.
HUB_PEPPER_TOKEN=

# Tailscale auth key for the sidecar (admin console > Settings > Keys).
# A reusable, tagged key is easiest; the node only needs to be up once to store its state.
TS_AUTHKEY=

# Optional
HUB_TIMEZONE=Europe/London
# Days ahead that count as "starts soon" (matches the tracker's 3-week flag)
HUB_SOON_DAYS=21
# The briefing warns if the last snapshot is older than this
HUB_STALE_HOURS=36
